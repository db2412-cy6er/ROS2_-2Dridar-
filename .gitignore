# ============================================================================
# ROS2 2D-Lidar 语义导航小车 —— 仓库根 .gitignore
# 原则：只忽略"可重新生成的产物"和"超过 GitHub 单文件 100MB 上限的大文件"
# ============================================================================

# ---------------------------------------------------------------- 编译产物
build/
install/
log/
devel/

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------- 嵌入式（ESP-IDF）
# idf.py reconfigure 会自动拉取，单个工程 ~400MB
managed_components/
.pio/
dependency-lock.json

# ---------------------------------------------------------------- 建图产物
# cartographer 中间件（单个 13MB+），导出后的 pgm/yaml 已入库
*.pbstream
*.pbf

# ---------------------------------------------------------------- 大文件（保留在本地）
# bags: 含 919MB 单个 rosbag，超过 GitHub 单文件 100MB 硬上限
xuegeros_ws/bags/
# 与 leap_ros/ 内容重复的打包产物
leap_demo/leap_ros.tar

# ---------------------------------------------------------------- 编辑器 / 系统
*.swp
*~
.DS_Store
